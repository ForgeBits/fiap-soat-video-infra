# ===========================================
# FIAP SOAT Video - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha com suas credenciais

# ===========================================
# Auth Service
# ===========================================
AUTH_POSTGRES_PASSWORD=your_auth_password_here
AUTH_DATABASE_URL=postgresql://auth_user:your_auth_password_here@postgres-auth:5432/auth_db
AUTH_JWT_SECRET=your_jwt_secret_auth_here

# ===========================================
# API Service
# ===========================================
API_DB_PASSWORD=your_api_password_here
API_DATABASE_URL=postgresql://api_user:your_api_password_here@postgres-api:5432/api_db
API_RABBITMQ_PASSWORD=your_rabbitmq_password_here
API_AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
API_JWT_SECRET=your_jwt_secret_api_here

# ===========================================
# RabbitMQ
# ===========================================
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here

# ===========================================
# PostgreSQL (Infrastructure)
# ===========================================
# Nota: As senhas padrão estão definidas nos secrets do K8s
# Se você alterá-las, também atualize:
# - k8s/infrastructure/postgres-auth.yaml (postgres-auth-secret)
# - k8s/infrastructure/postgres-api.yaml (postgres-api-secret)

# ===========================================
# AWS Terraform (Opcional)
# ===========================================
# TF_VAR_aws_region=us-east-1
# TF_VAR_cluster_name=fiap-soat-eks

